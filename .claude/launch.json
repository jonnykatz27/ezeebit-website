{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npx vite --port \"$PORT\" --strictPort"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/bin:$PATH npx vite preview --port \"$PORT\" --strictPort"],
      "port": 4173,
      "autoPort": true
    }
  ]
}
